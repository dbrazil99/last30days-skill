# Copy to .env and fill in. Never commit the real .env.
REGRID_API_TOKEN=
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides
MHP_CLAUDE_MODEL=claude-opus-5-5
MHP_OVERTURE_RELEASE=2026-10-21.0
MHP_DATA_DIR=./data
MHP_OUT_DIR=./out

# ---- HARD SPENDING CAPS (per calendar month; the bot stops before exceeding any) ----
# Phase 1 / pilot defaults. Raise only after Dylan approves Phase 2.
MHP_CAP_TOTAL_USD=100
MHP_CAP_CLAUDE_USD=50
MHP_CAP_GOOGLE_USD=0          # 0 = stay inside Google's free 5,000 calls/month
MHP_CAP_GOOGLE_CALLS=4500
MHP_CAP_PARCEL_USD=0          # 0 = trial / free data only
MHP_CAP_PARCEL_CALLS=1000
MHP_PARCEL_USD_PER_CALL=0     # set when ReportAll/Regrid quote a per-lookup price
